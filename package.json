{
  "name": "crx-playwright-ai",
  "version": "1.0.0",
  "description": "Automated smoke test generation from Chrome Extension recordings using AI",
  "type": "module",
  "scripts": {
    "smoke": "npx playwright test --grep @smoke",
    "test": "npx playwright test",
    "setup": "npx playwright install",
    "report": "npx playwright show-report",
    "report:open": "open playwright-report/index.html",
    "audit:selectors": "node tools/selector-audit.js",
    "generate": "node tools/generate-from-record.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^25.2.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
